{
  "name": "openclaw-visual-memory",
  "version": "1.0.1",
  "description": "Visual Memory hook for OpenClaw: runs the local vm.py register check on every inbound image and injects the result into the next agent turn.",
  "type": "module",
  "license": "MIT",
  "peerDependencies": {
    "openclaw": ">=2026.9.6"
  },
  "scripts": {
    "build": "esbuild index.ts --bundle --platform=node --format=esm --target=node20 --external:openclaw --outfile=dist/index.js"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.9.6"
    },
    "build": {
      "openclawVersion": "2026.9.6"
    }
  }
}
